# === Backend base ===
# Usa la raíz del backend (SIN /api al final). Cypress compone las rutas con los paths de abajo.
CYPRESS_API_BASEURL=http://localhost:8000

# === Usuarios de prueba ===
# Ajusta según tu semilla. En las seeds adjuntas existe: test@cypress.local con 'test-password'.
CYPRESS_ADMIN_EMAIL=copiamedion@gmail.com
CYPRESS_ADMIN_PASSWORD=key999test#
CYPRESS_RECRUITER_EMAIL=recruiter.test@hotmail.com
CYPRESS_RECRUITER_PASSWORD=recruiter123
CYPRESS_CANDIDATE_EMAIL=candidato.test2@gmail.com
CYPRESS_CANDIDATE_PASSWORD=candi12345#

# === Storage opcional (si tu UI guarda flags no sensibles) ===
CYPRESS_TOKEN_STORAGE_KEY=auth_token

# === CSRF (double-submit) ===
# Nombres por defecto del proyecto: cookie XSRF-TOKEN y cabecera X-CSRF-Token.
# Cambia si tu backend usa otros.
CYPRESS_CSRF_COOKIE=XSRF-TOKEN
CYPRESS_CSRF_HEADER=X-CSRF-Token

# === Paths de backend usados por los helpers de Cypress ===
# Se concatenan a CYPRESS_API_BASEURL
# Health
CYPRESS_HEALTH_PATH=/api/health.php
# (Opcionales alternativos por si los usas en tests puntuales)
# CYPRESS_HEALTH_AI_PATH=/api/health-ai.php
# CYPRESS_HEALTH_OCR_PATH=/api/health-ocr.php
# CYPRESS_HEALTH_CHECK_PATH=/api/health-check.php

# Autenticación (staff/candidato + sesión)
CYPRESS_LOGIN_STAFF_PATH=/api/auth/staff-login.php
CYPRESS_LOGIN_CANDIDATE_PATH=/api/auth/candidate-login.php
CYPRESS_LOGOUT_PATH=/api/auth/logout.php
CYPRESS_VERIFY_SESSION_PATH=/api/auth/verify-session.php
CYPRESS_USER_INFO_PATH=/api/auth/user-info.php
CYPRESS_PING_PATH=/api/auth/ping.php

# Registro (añadido)
# Opción A (si el script está bajo /auth):
CYPRESS_REGISTER_PATH=/api/auth/auth_register.php
# Opción B (si en tu servidor está en la raíz de /api):
# CYPRESS_REGISTER_PATH=/api/auth_register.php

# CSRF endpoints
CYPRESS_CSRF_VALIDATE_PATH=/api/auth/validate-csrf.php
CYPRESS_CSRF_TOKEN_PATH=/api/auth/csrf-token.php

# Social login (si lo cubres en E2E)
CYPRESS_SOCIAL_LOGIN_PATH=/api/auth/social-login.php
CYPRESS_SOCIAL_CALLBACK_PATH=/api/auth/social-callback.php
CYPRESS_GOOGLE_CALLBACK_PATH=/api/auth/google/callback.php
CYPRESS_LINKEDIN_CALLBACK_PATH=/api/auth/linkedin/callback.php

# === Modo de datos ===
CYPRESS_USE_REAL_DATA=true

# === (Opcional) Nombre de la cookie que setea /auth/*login*.php. Por defecto solemos usar jwt_token. ===
# CYPRESS_JWT_COOKIE=jwt_token