# Application Configuration
APP_ENV=development
APP_DEBUG=true
LOG_LEVEL=debug
APP_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://localhost:3000,http://127.0.0.1:3002,http://localhost:5173

# OpenAI Configuration
OPENAI_API_KEY=YOUR_OPENAI_KEY_HERE
OPENAI_MODEL=gpt-4o-mini

# Mail Configuration (development)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=bubbletalents@gmail.com
MAIL_PASSWORD=YOUR_APP_PASSWORD
MAIL_FROM=bubbletalents@gmail.com
MAIL_FROM_NAME="Bubble Talents Dev"

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_MAX_AGE=86400

# Cookie Configuration - Seguridad de Cookies
COOKIE_DOMAIN=                    # Vacío para desarrollo local, usar ".dominio.com" en prod
COOKIE_SAMESITE=Lax              # "Lax" | "Strict" | "None"
COOKIE_SECURE=false              # false para desarrollo HTTP, true para producción HTTPS

# Staff Email Domain Restriction
STAFF_EMAIL_DOMAIN=@bubblegum.agency
