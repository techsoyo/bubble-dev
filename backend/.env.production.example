# Backend Environment - PRODUCCIÓN
# Con# Staff Email Domain Restriction
STAFF_EMAIL_DOMAIN=@yourdomain.com

# Security Configuration
HTTPS=true                       # Forzar detección HTTPS
HIDE_TOKEN_IN_RESPONSE=true      # No devolver JWT en respuesta JSON (máxima seguridad)ación para entorno de producción

# Database Configuration
DB_HOST=your_production_db_host
DB_PORT=3306
DB_NAME=bubble_talents_DB_prod
DB_USER=production_user
DB_PASSWORD=super_secure_production_password
DB_TABLE_PREFIX=bt_

# JWT Configuration - SEGURO PARA PRODUCCIÓN
JWT_SECRET=CAMBIAR_POR_SECRETO_SUPER_SEGURO_DE_64_CARACTERES_MINIMO
JWT_EXPIRY=86400

# OAuth Configuration - Google (PRODUCCIÓN)
# Obtener credenciales en: https://console.developers.google.com/
GOOGLE_CLIENT_ID=your_production_google_client_id
GOOGLE_CLIENT_SECRET=your_production_google_client_secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/auth/social/google/callback

# OAuth Configuration - LinkedIn (PRODUCCIÓN)
# Obtener credenciales en: https://developer.linkedin.com/
LINKEDIN_CLIENT_ID=your_production_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_production_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://yourdomain.com/api/auth/social/linkedin/callback

# Frontend Configuration (PRODUCCIÓN)
FRONTEND_URL=https://yourdomain.com

# Application Configuration
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=error
APP_URL=https://yourdomain.com

# Mail Configuration
MAIL_HOST=smtp.production.com
MAIL_PORT=587
MAIL_USERNAME=production@yourdomain.com
MAIL_PASSWORD=production_mail_password
MAIL_FROM=production@yourdomain.com
MAIL_FROM_NAME="Bubble Talents"

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With
CORS_MAX_AGE=86400

# Cookie Configuration - Seguridad de Cookies PRODUCCIÓN
COOKIE_DOMAIN=.yourdomain.com     # Para compartir entre subdominios
COOKIE_SAMESITE=Strict           # Más restrictivo en producción
COOKIE_SECURE=true               # SIEMPRE true en producción (requiere HTTPS)

# Staff Email Domain Restriction
STAFF_EMAIL_DOMAIN=@yourdomain.com

# Security Configuration
HTTPS=true                       # Forzar detección de HTTPS
