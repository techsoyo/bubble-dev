{
  "name": "bubble-talents/automated-tests",
  "description": "Suite de testing automatizado para Bubble Talents",
  "type": "project",
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "squizlabs/php_codesniffer": "^3.7",
    "phpstan/phpstan": "^1.10"
  },
  "autoload": {
    "psr-4": {
      "Tests\\": "tests/"
    },
    "files": [
      "bootstrap.php",
      "TestCase.php",
      "tests/test_config.php"
    ]
  },
  "scripts": {
    "test": "phpunit",
    "test:smoke": "phpunit --testsuite=\"Smoke Tests\"",
    "test:security": "phpunit --testsuite=\"Security Tests\"",
    "test:unit": "phpunit --testsuite=\"Unit Tests\"",
    "test:integration": "phpunit --testsuite=\"Integration Tests\"",
    "test:coverage": "phpunit --coverage-html reports/coverage",
    "cs:check": "phpcs --standard=PSR12 tests/",
    "cs:fix": "phpcbf --standard=PSR12 tests/",
    "analyze": "phpstan analyse tests/ --level=5"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}