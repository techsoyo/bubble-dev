**/.env.local
**/.env.*.local
**/.env.production
**/.env.backup
# System files
**/cookies.txt

# Archivos sensibles de seguridad
# Temporary files
config_secure/
security_backup/
**/*.pem
**/*.key
**/*.crt
# Sensitive folders
**/.ssh/

# Archivos temporales
# Keep specific small files that are intentionally in repo
*.tmp
*.temp
varios/data/*.zip
varios/data/*.csv
docum/

# Ignorar carpetas llamadas `text`
**/text/**

# Patrones de debug adicionales
*debug*
debug.*
*.stacktrace

# Ignorar todos los archivos Markdown por defecto, excepto el README principal
*.md
!README.md

# OS/IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Artefactos
*.zip
*.tar.gz
