frontend/.next/
frontend/.nuxt/
/backend/.composer

# Node/NPM
frontend/.cache/
frontend/.vite/
frontend/coverage/

# Backend PHP
backend/vendor/
backend/storage/*
!backend/storage/.gitkeep
# Build directories
backend/public/uploads/*
!backend/public/uploads/.gitkeep
backend/.php-cs-fixer.cache

# Tests y reportes
# Coverage and reports
test-results/
playwright-report/
coverage/
varios/tests/playwright-report/
