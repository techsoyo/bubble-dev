# Bubble of Talents - Frontend Environment Configuration
# Copia este archivo como .env para configurar variables específicas

# API Configuration (opcional - se detecta automáticamente en desarrollo)
#VITE_API_BASE=https://tu-backend.tld
VITE_APP_ENV=development

# Authentication
VITE_JWT_SECRET_KEY=your-jwt-secret-here
VITE_SESSION_TIMEOUT=3600000

# External Services
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=
VITE_HOTJAR_ID=

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_ERROR_REPORTING=false
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ACCESSIBILITY_TOOLS=true

# Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=pdf,doc,docx

# Security
VITE_ENABLE_CSP=true
VITE_ENABLE_XSS_PROTECTION=true

# Development
VITE_MOCK_API=false
VITE_DEBUG_MODE=false
VITE_SHOW_PERFORMANCE_METRICS=false

# Build Configuration
VITE_BUILD_VERSION=1.0.0
VITE_BUILD_DATE=
