# Configuración para GroqApiService (COMPLETAMENTE GRATUITO)
# 
# Copia este archivo como .env y completa los valores requeridos

# ========================================
# GROQ API CONFIGURATION (GRATUITO)
# ========================================

# API Key de Groq (GRATIS)
# Obtener en: https://console.groq.com/keys
GROQ_API_KEY="gsk-tu-api-key-aqui"

# Base URL de la API Groq (compatible OpenAI)
GROQ_BASE_URL="https://api.groq.com/openai/v1"

# Modelo a usar (todos GRATIS)
# llama3-8b-8192: Rápido y eficiente (RECOMENDADO)
# llama3-70b-8192: Más potente pero más lento
# mixtral-8x7b-32768: Excelente para tareas complejas
# gemma-7b-it: Modelo de Google, muy bueno
GROQ_MODEL="llama3-8b-8192"

# Timeout en segundos (Groq es muy rápido, 120s es suficiente)
GROQ_TIMEOUT_SECONDS="120"

# ========================================
# CONFIGURACIÓN GENERAL
# ========================================

# Número máximo de reintentos en caso de error
AI_MAX_RETRIES="3"

# ========================================
# INFORMACIÓN IMPORTANTE
# ========================================

# 1. OBTENER API KEY GRATUITA:
#    - Ve a: https://console.groq.com/
#    - Haz clic en "Sign Up" (registro gratuito)
#    - Ve a "API Keys" en el dashboard
#    - Crea nueva API Key (gsk-xxxxx...)
#    - ¡COMPLETAMENTE GRATIS!

# 2. VENTAJAS DE GROQ:
#    - ⚡ Ultra rápido (chips LPU especializados)
#    - 🆓 Completamente gratuito
#    - 🔄 Compatible con OpenAI API
#    - 🚀 Sin límites estrictos para desarrollo
#    - 🤖 Múltiples modelos: Llama, Mixtral, Gemma

# 3. LÍMITES GENEROSOS:
#    - Rate limits muy altos para desarrollo
#    - Sin costo por tokens
#    - Sin necesidad de tarjeta de crédito

# 4. USAR EN CÓDIGO PHP:
#    require_once 'autoload.php';
#    $service = new Services\GroqApiService();
#    $result = $service->analyzeCvFromPdf('cv.pdf');

# 5. EJECUTAR TEST:
#    .\setup_groq.ps1        # Configurar
#    php verify_groq_setup.php  # Verificar
#    php test_groq_production.php  # Test completo

# 6. RENDIMIENTO ESPERADO:
#    - Análisis de CV: 2-10 segundos típico
#    - Más rápido que GPT-4 gracias a LPU chips
#    - Calidad comparable a modelos comerciales

# ========================================
# MODELOS DISPONIBLES (TODOS GRATIS)
# ========================================

# llama3-8b-8192:
#   - Contexto: 8K tokens
#   - Velocidad: Ultra rápida
#   - Uso: Ideal para CVs y tareas generales

# llama3-70b-8192:
#   - Contexto: 8K tokens  
#   - Velocidad: Rápida
#   - Uso: Tareas más complejas

# mixtral-8x7b-32768:
#   - Contexto: 32K tokens
#   - Velocidad: Buena
#   - Uso: Documentos largos

# gemma-7b-it:
#   - Contexto: 8K tokens
#   - Velocidad: Muy rápida
#   - Uso: Alternativa a Llama3
