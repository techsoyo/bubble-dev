# ===========================================
# BUBBLE OF TALENTS - ENVIRONMENT CONFIGURATION
# ===========================================
# Copy this file to .env and update values for your environment

# ===========================================
# API CONFIGURATION
# ===========================================
# Production: Use HTTPS URLs only
# Development: Use localhost or development server
VITE_API_BASE_URL=http://localhost/bubble_of_talents_1.0/backend/public
VITE_API_TIMEOUT=10000

# ===========================================
# AUTHENTICATION ENDPOINTS
# ===========================================
VITE_LOGIN_ENDPOINT=/api/auth/login
VITE_REGISTER_ENDPOINT=/api/auth/register
VITE_LOGOUT_ENDPOINT=/api/auth/logout
VITE_REFRESH_TOKEN_ENDPOINT=/api/auth/refresh
VITE_FORGOT_PASSWORD_ENDPOINT=/api/auth/forgot-password
VITE_RESET_PASSWORD_ENDPOINT=/api/auth/reset-password
VITE_USER_PROFILE_ENDPOINT=/api/user/profile
VITE_UPDATE_PROFILE_ENDPOINT=/api/user/update-profile

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# CSRF Protection
VITE_CSRF_TOKEN_ENDPOINT=/api/auth/csrf-token.php
VITE_CSRF_VALIDATE_ENDPOINT=/api/auth/validate-csrf.php

# File Upload Security
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png
VITE_UPLOAD_ENDPOINT=/api/upload

# Rate Limiting
VITE_MAX_REQUESTS_PER_MINUTE=60
VITE_MAX_LOGIN_ATTEMPTS=5

# ===========================================
# APPLICATION SETTINGS
# ===========================================
VITE_APP_NAME=Bubble of Talents
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Show test credentials in development only
VITE_SHOW_TEST_CREDENTIALS=false

# ===========================================
# EXTERNAL SERVICES
# ===========================================
# PDF Processing
VITE_PDF_PARSE_ENDPOINT=/api/analyze_cv.php

# Google Translation (if used)
VITE_GOOGLE_TRANSLATE_API_KEY=

# OAuth Configuration (if used)
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_LINKEDIN_CLIENT_ID=your_linkedin_client_id

# ===========================================
# MONITORING & ANALYTICS
# ===========================================
# Error Reporting (Sentry)
VITE_SENTRY_DSN=

# Analytics (Google Analytics)
VITE_GA_TRACKING_ID=

# Performance Monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ERROR_REPORTING=true

# ===========================================
# DEVELOPMENT SETTINGS
# ===========================================
# Debug mode (disable in production)
VITE_DEBUG_MODE=false
VITE_SHOW_PERFORMANCE_METRICS=false

# ===========================================
# SECURITY WARNINGS
# ===========================================
# ⚠️  NEVER commit .env file to version control
# ⚠️  Use HTTPS in production
# ⚠️  Rotate API keys regularly
# ⚠️  Use strong, unique passwords
# ===========================================