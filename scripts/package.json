{
  "name": "bubble-scripts",
  "type": "module",
  "version": "1.0.0",
  "description": "Scripts de migración y testing para Bubble of Talents",
  "main": "migrate-endpoints.ts",
  "scripts": {
    "migrate": "node migrate-endpoints.mjs",
    "run": "node run-migration.mjs",
    "test": "node run-tests.mjs",
    "diagnose": "node diagnose-backend.mjs",
    "test:endpoints": "npx playwright test tests/generated-endpoint-tests.spec.ts --reporter=line",
    "test:headed": "npx playwright test tests/generated-endpoint-tests.spec.ts --headed",
    "install:playwright": "npx playwright install"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "@playwright/test": "^1.40.0"
  }
}