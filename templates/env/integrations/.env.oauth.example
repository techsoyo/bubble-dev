# ===============================================
# CONFIGURACIÓN OAUTH - GOOGLE Y LINKEDIN
# ===============================================
# 
# INSTRUCCIONES:
# 1. Renombra este archivo a .env.oauth
# 2. Completa las credenciales obtenidas de Google y LinkedIn
# 3. Asegúrate de que este archivo NO esté en Git (.gitignore)
#
# ÚLTIMA ACTUALIZACIÓN: 15 de agosto 2025
# ===============================================

# ===============================================
# GOOGLE OAUTH 2.0 CONFIGURATION
# ===============================================
# Obtener en: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ===============================================
# LINKEDIN OAUTH 2.0 CONFIGURATION  
# ===============================================
# Obtener en: https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret_here
LINKEDIN_REDIRECT_URI=http://localhost:8000/auth/linkedin/callback

# ===============================================
# CONFIGURACIÓN GENERAL
# ===============================================
OAUTH_SESSION_SECRET=your_random_session_secret_here_minimum_32_chars
OAUTH_ENCRYPTION_KEY=your_encryption_key_here_exactly_32_chars

# ===============================================
# URLs DE PRODUCCIÓN (cambiar cuando depliegues)
# ===============================================
# GOOGLE_REDIRECT_URI=https://tudominio.com/auth/google/callback
# LINKEDIN_REDIRECT_URI=https://tudominio.com/auth/linkedin/callback

# ===============================================
# CONFIGURACIÓN DE DESARROLLO
# ===============================================
OAUTH_DEBUG=true
OAUTH_LOG_LEVEL=debug
