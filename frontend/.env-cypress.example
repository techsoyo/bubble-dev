# ==========================================
# ⚠️  IMPORTANTE: NO USAMOS MOCKS ⚠️
# ==========================================
# Estas pruebas E2E están diseñadas para usar DATOS REALES exclusivamente
# NO se usan simulaciones, mocks o datos ficticios
# Todas las pruebas interactúan con APIs reales y base de datos real
# ==========================================

# Cypress E2E Testing Environment Variables
# Archivo de ejemplo para configuración de pruebas E2E
# Copia este archivo como .env-cypress.local y configura con tus valores reales

# ==========================================
# API Configuration
# ==========================================
CYPRESS_API_BASEURL=http://localhost:8000/api
CYPRESS_FRONTEND_URL=http://localhost:3002

# ==========================================
# Admin Credentials (from bubbeTalents_DB.sql)
# ==========================================
CYPRESS_ADMIN_EMAIL=copiamedion@gmail.com
CYPRESS_ADMIN_PASSWORD=admin12345

# ==========================================
# Recruiter Credentials
# ==========================================
CYPRESS_RECRUITER_EMAIL=recruiter.test@hotmail.com
CYPRESS_RECRUITER_PASSWORD=recruiter12345

# ==========================================
# Candidate Credentials
# ==========================================
CYPRESS_CANDIDATE_EMAIL=candidato.test2@gmail.com
CYPRESS_CANDIDATE_PASSWORD=candi12345

# ==========================================
# Database Configuration
# ==========================================
CYPRESS_DB_HOST=localhost
CYPRESS_DB_NAME=bubbeTalents_DB
CYPRESS_DB_USER=root
CYPRESS_DB_PASSWORD=

# ==========================================
# Test Data IDs (from seed file)
# ==========================================
CYPRESS_TEST_JOB_ID=1
CYPRESS_TEST_CANDIDATE_ID=1
CYPRESS_TEST_APPLICATION_ID=1
CYPRESS_TEST_DEPARTMENT_ID=1

# ==========================================
# OAuth Configuration (for testing)
# ==========================================
CYPRESS_GOOGLE_CLIENT_ID=your-google-client-id
CYPRESS_GOOGLE_CLIENT_SECRET=your-google-client-secret
CYPRESS_LINKEDIN_CLIENT_ID=your-linkedin-client-id
CYPRESS_LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# ==========================================
# AI Service Configuration
# ==========================================
CYPRESS_GROQ_API_KEY=your-groq-api-key
CYPRESS_QWEN_API_KEY=your-qwen-api-key
CYPRESS_AI_MODEL=gpt-4

# ==========================================
# Email Service Configuration
# ==========================================
CYPRESS_SMTP_HOST=smtp.gmail.com
CYPRESS_SMTP_PORT=587
CYPRESS_SMTP_USER=your-email@gmail.com
CYPRESS_SMTP_PASSWORD=your-app-password

# ==========================================
# Calendar Integration
# ==========================================
CYPRESS_CALENDAR_API_KEY=your-calendar-api-key
CYPRESS_CALENDAR_ID=your-calendar-id

# ==========================================
# File Upload Configuration
# ==========================================
CYPRESS_MAX_FILE_SIZE=10485760
CYPRESS_ALLOWED_FILE_TYPES=pdf,doc,docx

# ==========================================
# Security Settings
# ==========================================
CYPRESS_JWT_SECRET=your-jwt-secret-key
CYPRESS_ENCRYPTION_KEY=your-encryption-key

# ==========================================
# Test Configuration
# ==========================================
CYPRESS_VIDEO=false
CYPRESS_SCREENSHOT_ON_RUN_FAILURE=true
CYPRESS_DEFAULT_COMMAND_TIMEOUT=10000
CYPRESS_REQUEST_TIMEOUT=15000
CYPRESS_RESPONSE_TIMEOUT=15000

# ==========================================
# Browser Configuration
# ==========================================
CYPRESS_BROWSER=chrome
CYPRESS_VIEWPORT_WIDTH=1280
CYPRESS_VIEWPORT_HEIGHT=720

# ==========================================
# Notification Settings
# ==========================================
CYPRESS_NOTIFICATION_EMAIL=test@example.com
CYPRESS_NOTIFICATION_SLACK_WEBHOOK=your-slack-webhook

# ==========================================
# Performance Testing
# ==========================================
CYPRESS_PERFORMANCE_BUDGET=true
CYPRESS_LARGEST_CONTENTFUL_PAINT=3000
CYPRESS_FIRST_INPUT_DELAY=100
CYPRESS_CUMULATIVE_LAYOUT_SHIFT=0.1

# ==========================================
# Accessibility Testing
# ==========================================
CYPRESS_ACCESSIBILITY_TESTING=true
CYPRESS_ACCESSIBILITY_LEVEL=AA

# ==========================================
# Custom Test Settings
# ==========================================
CYPRESS_RETRY_ON_NETWORK_FAILURE=true
CYPRESS_EXPERIMENTAL_STUDIO=false
CYPRESS_EXPERIMENTAL_RUN_EVENTS=true

# ==========================================
# WebSocket Configuration (for real-time features)
# ==========================================
CYPRESS_WEBSOCKET_URL=ws://localhost:8000/ws
CYPRESS_WEBSOCKET_RECONNECT_INTERVAL=5000
CYPRESS_WEBSOCKET_MAX_RECONNECT_ATTEMPTS=5

# ==========================================
# PWA & Service Worker Configuration
# ==========================================
CYPRESS_PWA_TESTING=true
CYPRESS_SERVICE_WORKER_CACHE_NAME=bubble-talents-v1
CYPRESS_PWA_OFFLINE_TESTING=true
CYPRESS_PWA_UPDATE_STRATEGY=immediate

# ==========================================
# Internationalization (i18n) Testing
# ==========================================
CYPRESS_DEFAULT_LANGUAGE=es
CYPRESS_SUPPORTED_LANGUAGES=es,en,fr
CYPRESS_LANGUAGE_SWITCH_TESTING=true
CYPRESS_RTL_LANGUAGE_TESTING=false

# ==========================================
# Responsive Design Testing
# ==========================================
CYPRESS_RESPONSIVE_BREAKPOINTS=mobile:375,tablet:768,desktop:1280,large:1920
CYPRESS_RESPONSIVE_TESTING=true
CYPRESS_MOBILE_USER_AGENT=Mozilla/5.0 (iPhone; CPU iPhone OS 14_7_1 like Mac OS X) AppleWebKit/605.1.15
CYPRESS_TABLET_USER_AGENT=Mozilla/5.0 (iPad; CPU OS 14_7_1 like Mac OS X) AppleWebKit/605.1.15

# ==========================================
# API Mocking & External Services
# ==========================================
CYPRESS_MOCK_EXTERNAL_APIS=false
CYPRESS_LINKEDIN_API_MOCK=false
CYPRESS_GOOGLE_API_MOCK=false
CYPRESS_CALENDAR_API_MOCK=false
CYPRESS_EMAIL_API_MOCK=false

# ==========================================
# Advanced Security Testing
# ==========================================
CYPRESS_SECURITY_TESTING=true
CYPRESS_XSS_TESTING=true
CYPRESS_CSRF_TESTING=true
CYPRESS_SQL_INJECTION_TESTING=true
CYPRESS_RATE_LIMITING_TEST=true

# ==========================================
# Performance & Lighthouse Testing
# ==========================================
CYPRESS_LIGHTHOUSE_TESTING=true
CYPRESS_LIGHTHOUSE_PERFORMANCE_THRESHOLD=85
CYPRESS_LIGHTHOUSE_ACCESSIBILITY_THRESHOLD=90
CYPRESS_LIGHTHOUSE_BEST_PRACTICES_THRESHOLD=85
CYPRESS_LIGHTHOUSE_SEO_THRESHOLD=85

# ==========================================
# Memory & Resource Testing
# ==========================================
CYPRESS_MEMORY_LEAK_TESTING=true
CYPRESS_MEMORY_THRESHOLD_MB=100
CYPRESS_NETWORK_REQUEST_LIMIT=50
CYPRESS_ASSET_SIZE_TESTING=true

# ==========================================
# Advanced Logging & Debugging
# ==========================================
CYPRESS_DEBUG_MODE=true
CYPRESS_LOG_LEVEL=debug
CYPRESS_CONSOLE_LOG_CAPTURE=true
CYPRESS_NETWORK_LOG_CAPTURE=true
CYPRESS_PERFORMANCE_LOG_CAPTURE=true

# ==========================================
# Third-party Integration Testing
# ==========================================
CYPRESS_GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
CYPRESS_HOTJAR_ID=your-hotjar-id
CYPRESS_INTERCOM_APP_ID=your-intercom-app-id
CYPRESS_ZENDESK_KEY=your-zendesk-key

# ==========================================
# Database Direct Access (for advanced testing)
# ==========================================
CYPRESS_DB_DIRECT_ACCESS=true
CYPRESS_DB_QUERY_TIMEOUT=30000
CYPRESS_DB_CONNECTION_POOL_SIZE=5
CYPRESS_DB_SSL_ENABLED=false

# ==========================================
# File Storage & CDN Configuration
# ==========================================
CYPRESS_FILE_STORAGE_PROVIDER=local
CYPRESS_CDN_URL=https://cdn.bubbletalents.com
CYPRESS_MAX_CONCURRENT_UPLOADS=3
CYPRESS_UPLOAD_CHUNK_SIZE_MB=5

# ==========================================
# Advanced Notification Testing
# ==========================================
CYPRESS_PUSH_NOTIFICATION_TESTING=true
CYPRESS_EMAIL_NOTIFICATION_TESTING=true
CYPRESS_SMS_NOTIFICATION_TESTING=false
CYPRESS_IN_APP_NOTIFICATION_TESTING=true

# ==========================================
# AI & Machine Learning Testing
# ==========================================
CYPRESS_AI_PROCESSING_TIMEOUT=30000
CYPRESS_AI_CONFIDENCE_THRESHOLD=0.8
CYPRESS_AI_FALLBACK_TESTING=true
CYPRESS_AI_MOCK_RESPONSES=false

# ==========================================
# Advanced Calendar Integration
# ==========================================
CYPRESS_CALENDAR_PROVIDER=google
CYPRESS_CALENDAR_TIMEZONE=Europe/Madrid
CYPRESS_CALENDAR_EVENT_REMINDER_MINUTES=15
CYPRESS_CALENDAR_SYNC_INTERVAL_MINUTES=5

# ==========================================
# Advanced Email Configuration
# ==========================================
CYPRESS_EMAIL_PROVIDER=smtp
CYPRESS_EMAIL_FROM=noreply@bubbletalents.com
CYPRESS_EMAIL_TEMPLATE_ENGINE=handlebars
CYPRESS_EMAIL_RATE_LIMIT_PER_HOUR=1000

# ==========================================
# Advanced OAuth Configuration
# ==========================================
CYPRESS_OAUTH_REDIRECT_URI=http://localhost:3002/auth/callback
CYPRESS_OAUTH_SCOPE=email,profile
CYPRESS_OAUTH_STATE_PARAMETER=true
CYPRESS_OAUTH_PKCE_ENABLED=true

# ==========================================
# Advanced Security Headers
# ==========================================
CYPRESS_SECURITY_HEADERS_TESTING=true
CYPRESS_CSP_ENABLED=true
CYPRESS_HSTS_ENABLED=true
CYPRESS_X_FRAME_OPTIONS=SAMEORIGIN

# ==========================================
# Advanced Performance Monitoring
# ==========================================
CYPRESS_PERFORMANCE_MONITORING=true
CYPRESS_CORE_WEB_VITALS=true
CYPRESS_LONG_TASKS_MONITORING=true
CYPRESS_LAYOUT_SHIFTS_MONITORING=true

# ==========================================
# Advanced Error Handling
# ==========================================
CYPRESS_ERROR_BOUNDARY_TESTING=true
CYPRESS_GLOBAL_ERROR_HANDLING=true
CYPRESS_ERROR_REPORTING_ENDPOINT=https://error.bubbletalents.com/api/errors
CYPRESS_ERROR_SAMPLING_RATE=1.0

# ==========================================
# Advanced Feature Flags
# ==========================================
CYPRESS_FEATURE_FLAG_TESTING=true
CYPRESS_AI_FEATURE_ENABLED=true
CYPRESS_CALENDAR_FEATURE_ENABLED=true
CYPRESS_OAUTH_FEATURE_ENABLED=true
CYPRESS_PWA_FEATURE_ENABLED=true

# ==========================================
# Advanced Testing Environments
# ==========================================
CYPRESS_ENVIRONMENT=development
CYPRESS_TEST_STAGE=integration
CYPRESS_PARALLEL_EXECUTION=true
CYPRESS_LOAD_BALANCING=true

# ==========================================
# Advanced Reporting & Analytics
# ==========================================
CYPRESS_TEST_REPORTING=true
CYPRESS_REPORT_FORMAT=json,html
CYPRESS_REPORT_STORAGE=s3
CYPRESS_ANALYTICS_ENABLED=true

# ==========================================
# Advanced CI/CD Integration
# ==========================================
CYPRESS_CI_PROVIDER=github
CYPRESS_ARTIFACT_RETENTION_DAYS=30
CYPRESS_TEST_PARALLELIZATION=4
CYPRESS_SHARDING_ENABLED=true
