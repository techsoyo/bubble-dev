{
    "name": "bubble-of-talents/backend",
    "description": "Backend de Bubble of Talents (aplicación, no paquete público).",
    "type": "project",
    "license": "proprietary",
    "require": {
        "smalot/pdfparser": "^2.12",
        "phpoffice/phpword": "^1.3",
        "firebase/php-jwt": "^6.0",
        "stichoza/google-translate-php": "^5.3"
    },
    "config": {
        "optimize-autoloader": true
    },
    "autoload": {
        "psr-4": {
            "Services\\": "src/Services/",
            "Controllers\\": "src/Controllers/",
            "Models\\": "src/Models/",
            "Utils\\": "src/Utils/",
            "Domain\\": "src/Domain/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^12.3"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
