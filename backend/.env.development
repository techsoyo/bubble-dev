# Backend Environment - DESARROLLO LOCAL
# Archivo para desarrollo local seguro

# Database Configuration
DB_HOST=192.168.1.40
DB_PORT=3306
DB_NAME=bubble_talents_DB
DB_USER=user
DB_PASSWORD=user123
DB_TABLE_PREFIX=bt_

# JWT Configuration - SEGURO PARA DESARROLLO
JWT_SECRET=YmQzNzJkZTNhNWY4YjE2YzQyOGU3ZDllZjNhNWI4YzQxMjM0NTY3ODkwYWJjZGVmMTIzNDU2Nzg5MGFiY2Rl
