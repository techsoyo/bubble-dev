# Frontend Environment Variables - DESARROLLO
# Archivo para desarrollo local
# Copiar a .env.local y configurar con valores reales

# API Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_API_PROXY_TARGET=http://localhost:8000

# OAuth Configuration (URLs para redireccionamiento)
VITE_GOOGLE_REDIRECT_URI=http://localhost:3002/auth/callback
VITE_LINKEDIN_REDIRECT_URI=http://localhost:3002/auth/callback

# Application Configuration
VITE_APP_NAME="Bubble of Talents"
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# Feature Flags
VITE_ENABLE_OAUTH=true
VITE_ENABLE_DEBUG=true
VITE_ENABLE_ANALYTICS=false

# Security Configuration
VITE_CSP_NONCE_ENABLED=false
VITE_ENABLE_ERROR_REPORTING=true
