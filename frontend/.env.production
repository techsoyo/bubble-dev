# API Configuration
VITE_API_BASE_URL=https://your-domain.com/api
VITE_API_PROXY_TARGET=https://your-domain.com/backend/public
VITE_APP_ENV=production

# Development Server (solo para desarrollo local)
VITE_DEV_PORT=3002
VITE_DEV_HOST=localhost
VITE_DEV_OPEN=false

# Authentication - CRIPTOGRÁFICAMENTE SEGURO
VITE_JWT_SECRET_KEY=ZmVkY2JhOTg3NjU0MzIxMGZlZGNiYTk4NzY1NDMyMTBmZWRjYmE5ODc2NTQzMjEwZmVkY2JhOTg3NjU0MzIxMA==
VITE_SESSION_TIMEOUT=3600000

# Build Information
VITE_BUILD_VERSION=1.0.0
VITE_BUILD_DATE=2025-08-20

# External Services - CONFIGURAR EN PRODUCCIÓN
VITE_GOOGLE_ANALYTICS_ID=YOUR_GA_ID_HERE
VITE_SENTRY_DSN=YOUR_SENTRY_DSN_HERE
VITE_HOTJAR_ID=YOUR_HOTJAR_ID_HERE

# Feature Flags - PRODUCCIÓN
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ACCESSIBILITY_TOOLS=true

# Upload Configuration
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=pdf,doc,docx

# Security Headers
VITE_ENABLE_CSP=true
VITE_ENABLE_SECURITY_HEADERS=true
