{
	"name": "bubble-dev",
	"private": true,
	"scripts": {
		"dev": "concurrently -n \"FE,BE\" -c \"bgBlue.bold,bgGreen.bold\" \"pnpm dev:fe\" \"pnpm dev:be\"",
		"dev:fe": "cd frontend && pnpm dev",
		"dev:be": "cd backend && php -S localhost:8000 -t public router.php",
		"cors:check": "node scripts/cors-check.mjs",
		"test:cors": "node scripts/cors-check.mjs"
	},
	"devDependencies": {
		"@testing-library/cypress": "^10.0.3",
		"concurrently": "^9.2.0",
		"cssnano": "^7.1.0",
		"cypress": "^15.0.0",
		"start-server-and-test": "^2.0.13"
	},
	"dependencies": {
		"@playwright/test": "^1.54.2"
	},
	"packageManager": "pnpm@10.15.0+sha512.486ebc259d3e999a4e8691ce03b5cac4a71cbeca39372a9b762cb500cfdf0873e2cb16abe3d951b1ee2cf012503f027b98b6584e4df22524e0c7450d9ec7aa7b"
}