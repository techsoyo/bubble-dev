# Configuración para QwenApiService (Alibaba Cloud Model Studio)
# 
# Copia este archivo como .env y completa los valores requeridos

# ========================================
# QWEN API CONFIGURATION (REQUERIDO)
# ========================================

# API Key de Alibaba Cloud Model Studio
# Obtener en: https://help.aliyun.com/zh/model-studio/developer-reference/get-api-key
QWEN_API_KEY="sk-tu-api-key-aqui"

# Base URL de la API (usar la URL compatible con OpenAI)
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# Modelo a usar (opciones: qwen-plus, qwen-max, qwen-turbo)
# qwen-plus: Balance entre velocidad y capacidad (RECOMENDADO)
# qwen-max: Máxima capacidad, más lento
# qwen-turbo: Más rápido, menor capacidad
QWEN_MODEL="qwen-plus"

# Timeout en segundos para las llamadas API
QWEN_TIMEOUT_SECONDS="180"

# ========================================
# CONFIGURACIÓN GENERAL
# ========================================

# Número máximo de reintentos en caso de error
AI_MAX_RETRIES="3"

# ========================================
# NOTAS IMPORTANTES
# ========================================

# 1. OBTENER API KEY:
#    - Registrarse en https://www.alibabacloud.com/
#    - Ir a Model Studio (百炼): https://bailian.console.aliyun.com/
#    - Crear API Key en configuración
#    - GRATIS: 1 millón de tokens incluidos

# 2. PRECIOS DESPUÉS DEL TIER GRATUITO:
#    - qwen-turbo: ~$0.0002/1K tokens
#    - qwen-plus: ~$0.0008/1K tokens  
#    - qwen-max: ~$0.0024/1K tokens

# 3. USAR EN CÓDIGO PHP:
#    require_once 'autoload.php';
#    $service = new Services\QwenApiService();
#    $result = $service->analyzeCvFromPdf('cv.pdf');

# 4. EJECUTAR TEST:
#    php test_qwen_production.php
