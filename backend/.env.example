# ⚠️ ARCHIVO DE EJEMPLO - NO USAR EN PRODUCCIÓN
# Copia este archivo como .env y completa con valores reales
# ❌ NUNCA subas el archivo .env real al repositorio

# Configuración de la Base de Datos
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=nombre
DB_USERNAME=usuario
DB_PASSWORD=clave
# Prefijo opcional para las tablas de la base de datos
DB_TABLE_PREFIX=bt_

# Configuración JWT - CRÍTICO: Usar clave segura de 32+ caracteres
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters_required
JWT_EXPIRY=86400  # 24 horas en segundos

# Configuración de OpenAI - ⚠️ MANTENER SEGURA
OPENAI_API_KEY=
OPENAI_MODEL=

# Configuración de la Aplicación
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=info
APP_URL=https://your-domain.com
CORS_ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# Configuración de Correo
MAIL_HOST=smtp.local
MAIL_PORT=587
MAIL_USERNAME=your_username
MAIL_PASSWORD=your_password
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="Bubble of Talents"
