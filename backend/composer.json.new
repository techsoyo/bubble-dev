{
    "name": "bubble-of-talents/backend",
    "description": "Backend de Bubble of Talents - Arquitectura moderna con librerías estándar",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.1",
        
        "smalot/pdfparser": "^2.12",
        "phpoffice/phpword": "^1.3",
        "firebase/php-jwt": "^6.0",
        "stichoza/google-translate-php": "^5.3",
        
        "guzzlehttp/guzzle": "^7.8",
        "openai-php/client": "^0.8",
        "orhanerday/open-ai": "^4.7",
        
        "doctrine/orm": "^2.17",
        "doctrine/dbal": "^3.7",
        "doctrine/migrations": "^3.6",
        
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "symfony/dependency-injection": "^6.4",
        "symfony/config": "^6.4",
        "symfony/yaml": "^6.4",
        "symfony/validator": "^6.4",
        "symfony/messenger": "^6.4",
        
        "monolog/monolog": "^3.5",
        "predis/predis": "^2.2",
        
        "ramsey/uuid": "^4.7",
        "league/flysystem": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "mockery/mockery": "^1.6",
        "phpstan/phpstan": "^1.10",
        "symfony/var-dumper": "^6.4",
        "fakerphp/faker": "^1.23"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/",
            "Services\\": "src/Services/",
            "Controllers\\": "src/Controllers/",
            "Models\\": "src/Models/",
            "Utils\\": "src/Utils/",
            "Domain\\": "src/Domain/",
            "Entities\\": "src/Entities/",
            "Repositories\\": "src/Repositories/",
            "DTOs\\": "src/DTOs/",
            "Jobs\\": "src/Jobs/",
            "Middleware\\": "src/Middleware/",
            "Factories\\": "src/Factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:coverage": "vendor/bin/phpunit --coverage-html coverage",
        "analyse": "vendor/bin/phpstan analyse",
        "migrate": "php scripts/doctrine_migrate.php",
        "serve": "php -S localhost:8000 -t public",
        "post-autoload-dump": [
            "php scripts/clear_cache.php"
        ]
    },
    "scripts-descriptions": {
        "test": "Ejecutar tests unitarios",
        "analyse": "Análisis estático con PHPStan",
        "migrate": "Ejecutar migraciones de BD",
        "serve": "Servidor de desarrollo"
    }
}
