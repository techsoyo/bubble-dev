/*
Características principales:
Métricas en tiempo real con indicadores de tendencia
Múltiples vistas (Resumen, Rendimiento, Predictivo, Insights)
Gráficos interactivos con Recharts
Insights de IA con recomendaciones automatizadas
Análisis predictivo para forecasting
Auto-actualización de datos
Exportación de reportes
Interfaz responsive con Material-UI
Funcionalidades de IA:
Recomendaciones automatizadas basadas en patrones
Alertas inteligentes sobre rendimiento
Predicciones de contrataciones futuras
Análisis de tendencias del mercado
Scoring de calidad de candidatos
Optimizaciones de procesos sugeridas
*/


import React, { useState, useEffect } from 'react';
import {
  Box,
  Card,
  CardContent,
  Typography,
  Select,
  MenuItem,
  FormControl,
  InputLabel,
  Chip,
  Avatar,
  LinearProgress,
  IconButton,
  Tooltip,
  Paper,
  List,
  ListItem,
  ListItemText,
  ListItemAvatar,
  Divider,
  Alert,
  CircularProgress,
  Switch,
  FormControlLabel,
  Button,
  Dialog,
  DialogTitle,
  DialogContent,
  DialogActions,
  TextField
} from '@mui/material';
import {
  BarChart,
  Bar,
  XAxis,
  YAxis,
  CartesianGrid,
  Tooltip as RechartsTooltip,
  ResponsiveContainer,
  LineChart,
  Line,
  PieChart,
  Pie,
  Cell,
  Area,
  AreaChart,
  RadarChart,
  PolarGrid,
  PolarAngleAxis,
  PolarRadiusAxis,
  Radar,
  Legend,
  ScatterChart,
  Scatter
} from 'recharts';
import {
  TrendingUp,
  TrendingDown,
  Analytics,
  Speed,
  People,
  Assignment,
  Timeline,
  Star,
  CheckCircle,
  Cancel,
  Info,
  Download,
  Refresh,
  FilterList,
  ViewModule,
  Settings,
  Insights,
  Analytics,
  AutoGraph,
  Psychology,
  School,
  Work,
  LocationOn,
  AttachMoney,
  AccessTime,
  Group,
  PersonSearch,
  Assessment
} from '@mui/icons-material';

// Interfaces para tipos de datos
interface RecruitmentMetrics {
  totalApplications: number;
  activePositions: number;
  successfulHires: number;
  averageTimeToHire: number;
  conversionRate: number;
  candidateQualityScore: number;
  recruiterEfficiency: number;
  diversityIndex: number;
}

interface AIInsight {
  id: string;
  type: 'recommendation' | 'prediction' | 'alert' | 'opportunity';
  title: string;
  description: string;
  confidence: number;
  impact: 'high' | 'medium' | 'low';
  category: string;
  actionable: boolean;
  timestamp: Date;
}

interface TrendData {
  period: string;
  applications: number;
  hires: number;
  qualityScore: number;
  timeToHire: number;
  cost: number;
}

interface PerformanceData {
  recruiter: string;
  positions: number;
  hires: number;
  avgTimeToHire: number;
  qualityScore: number;
  efficiency: number;
}

interface PredictiveAnalytics {
  hiringForecast: Array<{
    month: string;
    predicted: number;
    confidence: number;
  }>;
  skillDemandForecast: Array<{
    skill: string;
    currentDemand: number;
    predictedDemand: number;
    growth: number;
  }>;
  marketTrends: Array<{
    trend: string;
    impact: number;
    probability: number;
  }>;
}

const AIAnalyticsDashboard: React.FC = () => {
  const [timeRange, setTimeRange] = useState<string>('30d');
  const [metrics, setMetrics] = useState<RecruitmentMetrics | null>(null);
  const [insights, setInsights] = useState<AIInsight[]>([]);
  const [trendData, setTrendData] = useState<TrendData[]>([]);
  const [performanceData, setPerformanceData] = useState<PerformanceData[]>([]);
  const [predictiveData, setPredictiveData] = useState<PredictiveAnalytics | null>(null);
  const [loading, setLoading] = useState(true);
  const [autoRefresh, setAutoRefresh] = useState(true);
  const [selectedView, setSelectedView] = useState<'overview' | 'performance' | 'predictive' | 'insights'>('overview');
  const [exportDialogOpen, setExportDialogOpen] = useState(false);

  // Colores para gráficos
  const COLORS = ['#8884d8', '#82ca9d', '#ffc658', '#ff7300', '#0088fe', '#00c49f'];

  // Datos mock para desarrollo
  const mockMetrics: RecruitmentMetrics = {
    totalApplications: 1247,
    activePositions: 23,
    successfulHires: 89,
    averageTimeToHire: 18.5,
    conversionRate: 7.1,
    candidateQualityScore: 8.4,
    recruiterEfficiency: 92.3,
    diversityIndex: 85.2
  };

  const mockInsights: AIInsight[] = [
    {
      id: '1',
      type: 'recommendation',
      title: 'Optimizar proceso de screening',
      description: 'La IA detectó que el 23% de candidatos rechazados en entrevistas finales podrían haber sido filtrados en screening inicial.',
      confidence: 87,
      impact: 'high',
      category: 'Eficiencia',
      actionable: true,
      timestamp: new Date()
    },
    {
      id: '2',
      type: 'prediction',
      title: 'Incremento en demanda de desarrolladores',
      description: 'Se prevé un aumento del 35% en solicitudes para posiciones de desarrollo en los próximos 2 meses.',
      confidence: 92,
      impact: 'medium',
      category: 'Tendencias',
      actionable: true,
      timestamp: new Date()
    },
    {
      id: '3',
      type: 'alert',
      title: 'Bajo rendimiento en fuente de candidatos',
      description: 'LinkedIn ha mostrado una disminución del 18% en calidad de candidatos en las últimas 3 semanas.',
      confidence: 76,
      impact: 'medium',
      category: 'Calidad',
      actionable: true,
      timestamp: new Date()
    }
  ];

  const mockTrendData: TrendData[] = [
    { period: 'Sem 1', applications: 120, hires: 8, qualityScore: 7.5, timeToHire: 22, cost: 2500 },
    { period: 'Sem 2', applications: 135, hires: 12, qualityScore: 8.1, timeToHire: 19, cost: 2200 },
    { period: 'Sem 3', applications: 142, hires: 10, qualityScore: 8.3, timeToHire: 16, cost: 2100 },
    { period: 'Sem 4', applications: 158, hires: 15, qualityScore: 8.7, timeToHire: 15, cost: 1900 }
  ];

  useEffect(() => {
    loadDashboardData();

    if (autoRefresh) {
      const interval = setInterval(loadDashboardData, 300000); // 5 minutos
      return () => clearInterval(interval);
    }
  }, [timeRange, autoRefresh]);

  const loadDashboardData = async () => {
    setLoading(true);
    try {
      // Simular carga de datos
      await new Promise(resolve => setTimeout(resolve, 1000));

      setMetrics(mockMetrics);
      setInsights(mockInsights);
      setTrendData(mockTrendData);
      setPerformanceData([
        { recruiter: 'Ana García', positions: 12, hires: 8, avgTimeToHire: 16, qualityScore: 9.1, efficiency: 95 },
        { recruiter: 'Carlos López', positions: 15, hires: 11, avgTimeToHire: 18, qualityScore: 8.7, efficiency: 88 },
        { recruiter: 'María Rodríguez', positions: 8, hires: 6, avgTimeToHire: 14, qualityScore: 9.3, efficiency: 92 }
      ]);
      setPredictiveData({
        hiringForecast: [
          { month: 'Ene', predicted: 25, confidence: 85 },
          { month: 'Feb', predicted: 32, confidence: 82 },
          { month: 'Mar', predicted: 28, confidence: 78 },
          { month: 'Abr', predicted: 35, confidence: 75 }
        ],
        skillDemandForecast: [
          { skill: 'React', currentDemand: 45, predictedDemand: 58, growth: 28.9 },
          { skill: 'Python', currentDemand: 38, predictedDemand: 42, growth: 10.5 },
          { skill: 'AWS', currentDemand: 32, predictedDemand: 48, growth: 50.0 }
        ],
        marketTrends: [
          { trend: 'Trabajo remoto', impact: 0.85, probability: 0.92 },
          { trend: 'IA/ML Skills', impact: 0.78, probability: 0.88 },
          { trend: 'Sostenibilidad', impact: 0.65, probability: 0.75 }
        ]
      });
    } catch (error) {
      console.error('Error loading dashboard data:', error);
    } finally {
      setLoading(false);
    }
  };

  const renderMetricCard = (title: string, value: string | number, trend: number, icon: React.ReactNode, suffix?: string) => (
    <Card elevation={2}>
      <CardContent>
        <Box display="flex" alignItems="center" justifyContent="space-between">
          <Box>
            <Typography color="textSecondary" gutterBottom variant="body2">
              {title}
            </Typography>
            <Typography variant="h4" component="div">
              {value}{suffix}
            </Typography>
            <Box display="flex" alignItems="center" mt={1}>
              {trend > 0 ? (
                <TrendingUp color="success" fontSize="small" />
              ) : (
                <TrendingDown color="error" fontSize="small" />
              )}
              <Typography
                variant="body2"
                color={trend > 0 ? 'success.main' : 'error.main'}
                ml={0.5}
              >
                {Math.abs(trend)}%
              </Typography>
            </Box>
          </Box>
          <Avatar sx={{ bgcolor: 'primary.main' }}>
            {icon}
          </Avatar>
        </Box>
      </CardContent>
    </Card>
  );

  const renderInsightCard = (insight: AIInsight) => (
    <Card key={insight.id} elevation={1} sx={{ mb: 2 }}>
      <CardContent>
        <Box display="flex" alignItems="flex-start" justifyContent="space-between">
          <Box flex={1}>
            <Box display="flex" alignItems="center" mb={1}>
              <Chip
                label={insight.type}
                size="small"
                color={insight.type === 'alert' ? 'error' : 'primary'}
                sx={{ mr: 1 }}
              />
              <Chip
                label={insight.impact}
                size="small"
                variant="outlined"
                color={insight.impact === 'high' ? 'error' : insight.impact === 'medium' ? 'warning' : 'success'}
              />
            </Box>
            <Typography variant="h6" gutterBottom>
              {insight.title}
            </Typography>
            <Typography variant="body2" color="textSecondary" paragraph>
              {insight.description}
            </Typography>
            <Box display="flex" alignItems="center" justifyContent="space-between">
              <Box display="flex" alignItems="center">
                <Typography variant="caption" color="textSecondary">
                  Confianza: {insight.confidence}%
                </Typography>
                <LinearProgress
                  variant="determinate"
                  value={insight.confidence}
                  sx={{ ml: 1, width: 60 }}
                />
              </Box>
              {insight.actionable && (
                <Button size="small" variant="outlined">
                  Actuar
                </Button>
              )}
            </Box>
          </Box>
        </Box>
      </CardContent>
    </Card>
  );

  const renderOverviewTab = () => (
    <Box display="flex" flexDirection="column" gap={3}>
      {/* Métricas principales */}
      <Box display="flex" flexWrap="wrap" gap={3}>
        <Box flex="1 1 200px">
          {renderMetricCard('Aplicaciones Totales', metrics?.totalApplications || 0, 12, <People />)}
        </Box>
        <Box flex="1 1 200px">
          {renderMetricCard('Posiciones Activas', metrics?.activePositions || 0, -5, <Assignment />)}
        </Grid>
        <Grid item xs={12} sm={6} md={3}>
          {renderMetricCard('Contrataciones Exitosas', metrics?.successfulHires || 0, 18, <CheckCircle />)}
        </Grid>
        <Grid item xs={12} sm={6} md={3}>
          {renderMetricCard('Tiempo Promedio', metrics?.averageTimeToHire || 0, -8, <AccessTime />, ' días')}
        </Grid>

        {/* Gráfico de tendencias */}
        <Grid item xs={12} md={8}>
          <Card>
            <CardContent>
              <Typography variant="h6" gutterBottom>
                Tendencias de Reclutamiento
              </Typography>
              <ResponsiveContainer width="100%" height={300}>
                <LineChart data={trendData}>
                  <CartesianGrid strokeDasharray="3 3" />
                  <XAxis dataKey="period" />
                  <YAxis />
                  <RechartsTooltip />
                  <Legend />
                  <Line type="monotone" dataKey="applications" stroke="#8884d8" name="Aplicaciones" />
                  <Line type="monotone" dataKey="hires" stroke="#82ca9d" name="Contrataciones" />
                  <Line type="monotone" dataKey="qualityScore" stroke="#ffc658" name="Calidad (x10)" />
                </LineChart>
              </ResponsiveContainer>
            </CardContent>
          </Card>
        </Grid>

        {/* Insights de IA */}
        <Grid item xs={12} md={4}>
          <Card>
            <CardContent>
              <Typography variant="h6" gutterBottom>
                Insights de IA
              </Typography>
              <Box maxHeight={300} overflow="auto">
                {insights.slice(0, 3).map(renderInsightCard)}
              </Box>
            </CardContent>
          </Card>
        </Grid>
      </Grid>
      );

  const renderPerformanceTab = () => (
      <Grid container spacing={3}>
        <Grid item xs={12}>
          <Card>
            <CardContent>
              <Typography variant="h6" gutterBottom>
                Rendimiento por Reclutador
              </Typography>
              <ResponsiveContainer width="100%" height={400}>
                <BarChart data={performanceData}>
                  <CartesianGrid strokeDasharray="3 3" />
                  <XAxis dataKey="recruiter" />
                  <YAxis />
                  <RechartsTooltip />
                  <Legend />
                  <Bar dataKey="hires" fill="#8884d8" name="Contrataciones" />
                  <Bar dataKey="efficiency" fill="#82ca9d" name="Eficiencia %" />
                </BarChart>
              </ResponsiveContainer>
            </CardContent>
          </Card>
        </Grid>
      </Grid>
      );

  const renderPredictiveTab = () => (
      <Grid container spacing={3}>
        {predictiveData && (
          <>
            <Grid item xs={12} md={6}>
              <Card>
                <CardContent>
                  <Typography variant="h6" gutterBottom>
                    Pronóstico de Contrataciones
                  </Typography>
                  <ResponsiveContainer width="100%" height={300}>
                    <AreaChart data={predictiveData.hiringForecast}>
                      <CartesianGrid strokeDasharray="3 3" />
                      <XAxis dataKey="month" />
                      <YAxis />
                      <RechartsTooltip />
                      <Area type="monotone" dataKey="predicted" stroke="#8884d8" fill="#8884d8" />
                    </AreaChart>
                  </ResponsiveContainer>
                </CardContent>
              </Card>
            </Grid>
            <Grid item xs={12} md={6}>
              <Card>
                <CardContent>
                  <Typography variant="h6" gutterBottom>
                    Demanda de Habilidades
                  </Typography>
                  <List>
                    {predictiveData.skillDemandForecast.map((skill, index) => (
                      <ListItem key={index}>
                        <ListItemText
                          primary={skill.skill}
                          secondary={`Crecimiento: ${skill.growth}%`}
                        />
                        <Chip
                          label={`+${skill.growth}%`}
                          size="small"
                          color={skill.growth > 20 ? 'success' : 'default'}
                        />
                      </ListItem>
                    ))}
                  </List>
                </CardContent>
              </Card>
            </Grid>
          </>
        )}
      </Grid>
      );

      if (loading) {
    return (
      <Box display="flex" justifyContent="center" alignItems="center" minHeight="400px">
        <CircularProgress />
      </Box>
      );
  }

      return (
      <Box p={3}>
        {/* Header */}
        <Box display="flex" justifyContent="space-between" alignItems="center" mb={3}>
          <Typography variant="h4" component="h1">
            Dashboard de Analytics con IA
          </Typography>
          <Box display="flex" gap={2}>
            <FormControl size="small">
              <InputLabel>Período</InputLabel>
              <Select
                value={timeRange}
                onChange={(e) => setTimeRange(e.target.value)}
                label="Período"
              >
                <MenuItem value="7d">7 días</MenuItem>
                <MenuItem value="30d">30 días</MenuItem>
                <MenuItem value="90d">90 días</MenuItem>
                <MenuItem value="1y">1 año</MenuItem>
              </Select>
            </FormControl>
            <FormControlLabel
              control={
                <Switch
                  checked={autoRefresh}
                  onChange={(e) => setAutoRefresh(e.target.checked)}
                />
              }
              label="Auto-actualizar"
            />
            <IconButton onClick={loadDashboardData}>
              <Refresh />
            </IconButton>
            <IconButton onClick={() => setExportDialogOpen(true)}>
              <Download />
            </IconButton>
          </Box>
        </Box>

        {/* Navegación de pestañas */}
        <Box mb={3}>
          <Box display="flex" gap={1}>
            {[
              { key: 'overview', label: 'Resumen', icon: <Analytics /> },
              { key: 'performance', label: 'Rendimiento', icon: <Speed /> },
              { key: 'predictive', label: 'Predictivo', icon: <Timeline /> },
              { key: 'insights', label: 'Insights', icon: <Insights /> }
            ].map((tab) => (
              <Button
                key={tab.key}
                variant={selectedView === tab.key ? 'contained' : 'outlined'}
                startIcon={tab.icon}
                onClick={() => setSelectedView(tab.key as any)}
              >
                {tab.label}
              </Button>
            ))}
          </Box>
        </Box>

        {/* Contenido de pestañas */}
        {selectedView === 'overview' && renderOverviewTab()}
        {selectedView === 'performance' && renderPerformanceTab()}
        {selectedView === 'predictive' && renderPredictiveTab()}
        {selectedView === 'insights' && (
          <Grid container spacing={3}>
            <Grid item xs={12}>
              <Card>
                <CardContent>
                  <Typography variant="h6" gutterBottom>
                    Todos los Insights de IA
                  </Typography>
                  {insights.map(renderInsightCard)}
                </CardContent>
              </Card>
            </Grid>
          </Grid>
        )}

        {/* Dialog de exportación */}
        <Dialog open={exportDialogOpen} onClose={() => setExportDialogOpen(false)}>
          <DialogTitle>Exportar Datos</DialogTitle>
          <DialogContent>
            <Typography variant="body2" paragraph>
              Selecciona el formato de exportación para los datos del dashboard.
            </Typography>
            <FormControl fullWidth margin="normal">
              <InputLabel>Formato</InputLabel>
              <Select defaultValue="pdf" label="Formato">
                <MenuItem value="pdf">PDF</MenuItem>
                <MenuItem value="excel">Excel</MenuItem>
                <MenuItem value="csv">CSV</MenuItem>
              </Select>
            </FormControl>
          </DialogContent>
          <DialogActions>
            <Button onClick={() => setExportDialogOpen(false)}>Cancelar</Button>
            <Button variant="contained">Exportar</Button>
          </DialogActions>
        </Dialog>
      </Box>
      );
};

      export default AIAnalyticsDashboard;
