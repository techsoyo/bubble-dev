# ===========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ===========================================
# ⚠️  CRITICAL: This is for PRODUCTION deployment
# ⚠️  Copy to .env.production and update ALL values

# ===========================================
# API CONFIGURATION - PRODUCTION ONLY
# ===========================================
# 🔒 MUST use HTTPS in production
VITE_API_BASE_URL=https://api.yourdomain.com
VITE_API_TIMEOUT=15000

# ===========================================
# AUTHENTICATION ENDPOINTS
# ===========================================
VITE_LOGIN_ENDPOINT=/api/auth/login
VITE_REGISTER_ENDPOINT=/api/auth/register
VITE_LOGOUT_ENDPOINT=/api/auth/logout
VITE_REFRESH_TOKEN_ENDPOINT=/api/auth/refresh
VITE_FORGOT_PASSWORD_ENDPOINT=/api/auth/forgot-password
VITE_RESET_PASSWORD_ENDPOINT=/api/auth/reset-password
VITE_USER_PROFILE_ENDPOINT=/api/user/profile
VITE_UPDATE_PROFILE_ENDPOINT=/api/user/update-profile

# ===========================================
# SECURITY CONFIGURATION - STRICT
# ===========================================
# CSRF Protection
VITE_CSRF_TOKEN_ENDPOINT=/api/auth/csrf-token.php
VITE_CSRF_VALIDATE_ENDPOINT=/api/auth/validate-csrf.php

# File Upload Security - REDUCED for production
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=application/pdf
VITE_UPLOAD_ENDPOINT=/api/upload

# Rate Limiting - STRICT for production
VITE_MAX_REQUESTS_PER_MINUTE=30
VITE_MAX_LOGIN_ATTEMPTS=3

# ===========================================
# APPLICATION SETTINGS
# ===========================================
VITE_APP_NAME=Bubble of Talents
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production

# NEVER show test credentials in production
VITE_SHOW_TEST_CREDENTIALS=false

# ===========================================
# EXTERNAL SERVICES - SECURE KEYS
# ===========================================
# PDF Processing
VITE_PDF_PARSE_ENDPOINT=/api/analyze_cv.php

# Google Translation
VITE_GOOGLE_TRANSLATE_API_KEY=your_production_google_api_key

# OAuth Configuration
VITE_GOOGLE_CLIENT_ID=your_production_google_client_id
VITE_LINKEDIN_CLIENT_ID=your_production_linkedin_client_id

# ===========================================
# MONITORING & ANALYTICS - ENABLED
# ===========================================
# Error Reporting (REQUIRED in production)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# Analytics (Google Analytics)
VITE_GA_TRACKING_ID=GA-XXXXXXXXXX

# Performance Monitoring (ENABLED in production)
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ERROR_REPORTING=true

# ===========================================
# PRODUCTION SECURITY SETTINGS
# ===========================================
# Debug mode DISABLED in production
VITE_DEBUG_MODE=false
VITE_SHOW_PERFORMANCE_METRICS=false

# ===========================================
# PRODUCTION SECURITY CHECKLIST
# ===========================================
# ✅ HTTPS enabled for all endpoints
# ✅ Debug mode disabled
# ✅ Test credentials hidden
# ✅ File size limits reduced
# ✅ Rate limiting stricter
# ✅ Error reporting enabled
# ✅ Analytics configured
# ✅ API keys rotated for production
# ===========================================
