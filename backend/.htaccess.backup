# 🚀 OPTIMIZACIÓN: Configuración Apache para compresión y caché
# 
# Habilita:
# - Compresión gzip/brotli para todos los assets
# - Caché optimizado para diferentes tipos de archivo
# - Headers de seguridad y rendimiento
# - Optimizaciones específicas para APIs del chatbot

# =====================================================
# COMPRESIÓN GZIP Y BROTLI
# =====================================================

<IfModule mod_deflate.c>
    # Habilitar compresión para tipos de archivo específicos
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE application/json
    AddOutputFilterByType DEFLATE application/ld+json
    
    # Comprimir específicamente las respuestas de las APIs del chatbot
    AddOutputFilterByType DEFLATE application/json
    
    # No comprimir imágenes ya optimizadas
    SetEnvIfNoCase Request_URI \
        \.(?:gif|jpe?g|png|webp|avif)$ no-gzip dont-vary
    SetEnvIfNoCase Request_URI \
        \.(?:exe|t?gz|zip|bz2|sit|rar)$ no-gzip dont-vary
        
    # Asegurar que proxies manejen correctamente las variaciones
    Header append Vary Accept-Encoding env=!dont-vary
</IfModule>

# Compresión Brotli (si está disponible)
<IfModule mod_brotli.c>
    # Configuración Brotli para mejor compresión que gzip
    BrotliCompressionLevel 6
    BrotliFilterNote Input instream
    BrotliFilterNote Output outstream
    BrotliFilterNote Ratio ratio
    
    # Aplicar Brotli a los mismos tipos que gzip
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
    AddOutputFilterByType BROTLI_COMPRESS text/javascript application/javascript application/x-javascript
    AddOutputFilterByType BROTLI_COMPRESS application/json application/xml application/rss+xml
    AddOutputFilterByType BROTLI_COMPRESS image/svg+xml
    
    LogFormat '"%r" %{outstream}n/%{instream}n (%{ratio}n%%)' brotli
    CustomLog logs/brotli_log brotli
</IfModule>

# =====================================================
# CACHÉ OPTIMIZADO POR TIPO DE ARCHIVO
# =====================================================

<IfModule mod_expires.c>
    ExpiresActive On
    
    # Caché por defecto
    ExpiresDefault "access plus 1 month"
    
    # APIs del chatbot - caché corto para datos dinámicos
    ExpiresByType application/json "access plus 5 minutes"
    
    # HTML - caché muy corto para permitir actualizaciones rápidas
    ExpiresByType text/html "access plus 1 hour"
    
    # CSS y JavaScript - caché largo (se invalidará con hash de versión)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    
    # Imágenes - caché muy largo
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/avif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    
    # Fuentes - caché largo
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    
    # Manifests y iconos
    ExpiresByType application/manifest+json "access plus 1 week"
    ExpiresByType image/x-icon "access plus 1 year"
</IfModule>

# Headers de caché alternativos si mod_expires no está disponible
<IfModule mod_headers.c>
    # Caché para assets estáticos
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|avif|ico|svg|woff|woff2|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    
    # Caché corto para APIs del chatbot
    <FilesMatch "chatbot.*\.php$">
        Header set Cache-Control "public, max-age=300"
        Header set Vary "Accept-Encoding, Authorization"
    </FilesMatch>
    
    # No caché para otros archivos PHP
    <FilesMatch "\.php$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

# =====================================================
# HEADERS DE SEGURIDAD Y RENDIMIENTO
# =====================================================

<IfModule mod_headers.c>
    # Headers de seguridad
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    
    # CSP optimizado para el chatbot
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://api.openai.com wss:; media-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self';"
    
    # Headers de rendimiento
    Header always set X-Served-By "optimized-apache"
    Header always set X-Cache-Status "MISS"
    
    # Server push para recursos críticos del chatbot (HTTP/2)
    <FilesMatch "index\.html$">
        Header add Link "</css/chatbot.css>; rel=preload; as=style"
        Header add Link "</js/chatbot-core.js>; rel=preload; as=script"
        Header add Link "</images/chatbot-avatar.webp>; rel=preload; as=image"
    </FilesMatch>
</IfModule>

# =====================================================
# REESCRITURA Y ENRUTAMIENTO OPTIMIZADO
# =====================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Redirección HTTPS (si está disponible)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Optimización: servir archivos estáticos directamente
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^(.*\.(css|js|png|jpg|jpeg|gif|webp|avif|ico|svg|woff|woff2|ttf|otf))$ - [L]
    
    # API del chatbot - enrutamiento optimizado
    RewriteRule ^api/chatbot/(.*)$ api/chatbot.php/$1 [L,QSA]
    RewriteRule ^api/endpoints/chatbot_(.*)$ api/endpoints/chatbot_$1 [L,QSA]
    
    # Fallback para SPA (Single Page Application)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteRule ^(.*)$ index.html [L]
</IfModule>

# =====================================================
# OPTIMIZACIONES ESPECÍFICAS DEL CHATBOT
# =====================================================

# Habilitar Keep-Alive para APIs del chatbot
# (Usando FilesMatch en lugar de LocationMatch porque este es un .htaccess)
# <IfModule mod_headers.c>
#     # Aplicar a todos los archivos PHP en el directorio api o con nombre específico
#     <FilesMatch "(^|/)api/.*\.php$">
#         Header set Connection "Keep-Alive"
#         Header set Keep-Alive "timeout=5, max=100"
#     </FilesMatch>
# </IfModule>

# Configuración de ETags para versionado
<IfModule mod_headers.c>
    # Eliminar ETags por defecto para archivos estáticos (usamos Cache-Control)
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|avif|ico|svg|woff|woff2)$">
        Header unset ETag
        FileETag None
    </FilesMatch>
    
    # Mantener ETags para APIs dinámicas
    <FilesMatch "\.php$">
        FileETag MTime Size
    </FilesMatch>
</IfModule>

# =====================================================
# LÍMITES Y TIMEOUTS OPTIMIZADOS
# =====================================================

# Aumentar límites para uploads de CV en el chatbot
#LimitRequestBody 10485760  # 10MB

# Timeout optimizado para APIs del chatbot
<IfModule mod_reqtimeout.c>
    RequestReadTimeout header=20-40,MinRate=500 body=20,MinRate=500
</IfModule>

# =====================================================
# LOGGING Y MONITOREO
# =====================================================

<IfModule mod_log_config.c>
    # Log personalizado para APIs del chatbot
    #LogFormat "%h %l %u %t \"%r\" %>s %O \"%{Referer}i\" \"%{User-Agent}i\" %D %{X-Cache-Status}o" chatbot_combined
    
    # Log condicional solo para APIs del chatbot
    SetEnvIf Request_URI "^/api/chatbot" chatbot_api
    #CustomLog logs/chatbot_access.log chatbot_combined env=chatbot_api
</IfModule>

# =====================================================
# CONFIGURACIÓN DE MIME TYPES MODERNOS
# =====================================================

<IfModule mod_mime.c>
    # Tipos MIME modernos para mejor rendimiento
    AddType image/webp .webp
    AddType image/avif .avif
    AddType font/woff2 .woff2
    AddType application/manifest+json .webmanifest
    
    # Configurar codificación para APIs JSON
    AddType application/json .json
    AddDefaultCharset UTF-8
</IfModule>

# =====================================================
# DIRECTIVAS DE SEGURIDAD ADICIONALES
# =====================================================

# Prevenir acceso a archivos sensibles
<FilesMatch "^(\.env|\.htaccess|\.htpasswd|composer\.(json|lock)|package\.(json|lock))$">
    Require all denied
</FilesMatch>

# Prevenir ejecución de PHP en directorios de uploads
<Directory "uploads/">
    <FilesMatch "\.php$">
        Require all denied
    </FilesMatch>
</Directory>

# Fin de configuración de optimización Apache

