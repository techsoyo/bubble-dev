<?php
require_once __DIR__ . '/../config/bo        $stmt = $pdo->prepare("
            INSERT INTO bt_candidates (
                id, first_name, last_name, name, email, password_hash, phone, location, 
                created_at, data_source, gdpr_consent_given
            ) VALUES (?, ?, ?, ?, ?, NULL, ?, ?, NOW(), 'manual_entry', 1)
        ");
        $stmt->execute([$candidateId, $firstName, $lastName, $name, $email, $phone, $location]);ap.php';

header('Content-Type: application/json');
header('Access-Control-Allow-Origin: *');
header('Access-Control-Allow-Methods: POST');
header('Access-Control-Allow-Headers: Content-Type');

if ($_SERVER['REQUEST_METHOD'] !== 'POST') {
  http_response_code(405);
  echo json_encode(['error' => 'Método no permitido']);
  exit;
}

try {
  $input = json_decode(file_get_contents('php://input'), true);

  if (!$input) {
    throw new Exception('JSON inválido');
  }

  $candidateData = $input['candidate_data'] ?? [];
  $jobId = $input['job_id'] ?? null;

  // Validar datos mínimos
  if (empty($candidateData['nombre']) || empty($candidateData['email'])) {
    throw new Exception('Nombre y email son requeridos');
  }

  $pdo = getDbConnection();
  $pdo->beginTransaction();

  try {
    // 1. Crear candidato simple
    $candidateId = 'cand-' . uniqid();
    $name = $candidateData['nombre'];
    $nameParts = explode(' ', trim($name), 2);
    $firstName = $nameParts[0] ?? '';
    $lastName = $nameParts[1] ?? '';

    $email = $candidateData['email'];
    $phone = $candidateData['telefono'] ?? '';
    $location = $candidateData['ubicacion_actual'] ?? '';

    $stmt = $pdo->prepare("
            INSERT INTO bt_candidates (id, first_name, last_name, name, email, phone, location, created_at, data_source, gdpr_consent_given)
            VALUES (?, ?, ?, ?, ?, ?, ?, NOW(), 'manual_entry', 1)
        ");
    $stmt->execute([$candidateId, $firstName, $lastName, $name, $email, $phone, $location]);
    $applicationId = null;

    // 2. Si hay job_id, crear aplicación
    if ($jobId) {
      // Verificar que el trabajo existe
      $jobCheck = $pdo->prepare("SELECT id FROM bt_jobs WHERE id = ?");
      $jobCheck->execute([$jobId]);

      if ($jobCheck->fetch()) {
        $applicationId = 'app-' . uniqid();

        $stmt = $pdo->prepare("
                    INSERT INTO bt_applications (id, job_id, candidate_id, status, created_at)
                    VALUES (?, ?, ?, 'pending', NOW())
                ");
        $stmt->execute([$applicationId, $jobId, $candidateId]);
      } else {
        error_log("Job ID $jobId no existe");
      }
    }

    $pdo->commit();

    $response = [
      'success' => true,
      'message' => 'Candidato registrado exitosamente',
      'data' => [
        'candidate_id' => $candidateId,
        'email' => $email,
        'nombre' => $name
      ]
    ];

    if ($applicationId) {
      $response['application'] = [
        'application_id' => $applicationId,
        'job_id' => $jobId,
        'status' => 'pending',
        'message' => 'Aplicación creada exitosamente'
      ];
    }

    echo json_encode($response);
  } catch (Exception $e) {
    $pdo->rollback();
    throw $e;
  }
} catch (Exception $e) {
  http_response_code(400);
  echo json_encode([
    'error' => 'Error en el registro',
    'message' => $e->getMessage(),
    'timestamp' => date('Y-m-d H:i:s')
  ]);
}
